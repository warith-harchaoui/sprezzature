#!/usr/bin/env bash
# Pre-push gate: block the push on a lint, type or test failure, so a red local
# state never reaches CI. The steps mirror this repository's own workflow, in
# the same order, so "the hook passed" and "CI will pass" mean the same thing.
#
# One-time setup per clone (the repo config already does it here):
#   git config core.hooksPath .githooks
# Bypass, rare and deliberate only:
#   git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] ruff..."
ruff check . || { echo "[pre-push] ruff failed - push aborted."; exit 1; }

echo "[pre-push] mypy..."
./scripts/run_mypy.sh || { echo "[pre-push] mypy failed - push aborted."; exit 1; }

echo "[pre-push] pytest..."
python3 -m pytest -q || { echo "[pre-push] pytest failed - push aborted."; exit 1; }

echo "[pre-push] skill validation..."
python3 scripts/validate_all.py || { echo "[pre-push] skill validation failed - push aborted."; exit 1; }

# The eval suite used to live here and this step checked that it still
# collected — a real risk, since `-m eval` is excluded from the default run,
# so a syntax error in one of those files is invisible until someone asks for
# them by name. The four eval modules left with their bricks during the
# monorepo split; `tests/eval/` stayed behind as an empty shell with a
# conftest still describing modules that were gone, and `pytest -m eval`
# returned exit 5 ("no tests collected"), which this step read as a failure.
#
# The check did not disappear: it moved to the two repositories that actually
# have eval tests now, `sprezzature-accessibility` (6) and
# `sprezzature-publish` (2). A guard belongs where it can see the thing.

echo "[pre-push] all green - pushing."
