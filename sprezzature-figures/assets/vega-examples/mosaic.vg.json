{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 440,
  "height": 260,
  "padding": {"top": 64, "left": 6, "right": 30, "bottom": 44},
  "autosize": "none",
  "background": "#FFFFFF",
  "config": {
    "font": "Roboto",
    "text": {"font": "Roboto"},
    "range": {"category": ["#007AFF", "#FF9500", "#AF52DE"]}
  },
  "title": {
    "text": "Streaming is now the biggest slice of media revenue",
    "subtitle": ["Column width = share of $18.4B total revenue · height = mix within each business · Illustrative data"],
    "anchor": "start",
    "font": "Roboto",
    "fontSize": 14,
    "color": "#1D1D1F",
    "subtitleFont": "Roboto",
    "subtitleFontSize": 10.5,
    "subtitleColor": "#6E6E73",
    "offset": 8
  },
  "signals": [
    {"name": "gap", "value": 3}
  ],
  "data": [
    {
      "name": "raw",
      "values": [
        {"segment": "Streaming", "source": "Subscriptions", "value": 6.9},
        {"segment": "Streaming", "source": "Advertising", "value": 2.4},
        {"segment": "Streaming", "source": "Licensing", "value": 0.8},

        {"segment": "Cable", "source": "Subscriptions", "value": 3.1},
        {"segment": "Cable", "source": "Advertising", "value": 1.9},
        {"segment": "Cable", "source": "Licensing", "value": 0.6},

        {"segment": "Studio", "source": "Subscriptions", "value": 0.4},
        {"segment": "Studio", "source": "Advertising", "value": 0.5},
        {"segment": "Studio", "source": "Licensing", "value": 1.4}
      ]
    },
    {
      "name": "segTotals",
      "source": "raw",
      "transform": [
        {"type": "aggregate", "groupby": ["segment"], "fields": ["value"], "ops": ["sum"], "as": ["segTotal"]},
        {"type": "stack", "field": "segTotal", "as": ["colStart", "colEnd"], "sort": {"field": "segTotal", "order": "descending"}},
        {"type": "collect", "sort": {"field": "colStart"}},
        {"type": "window", "ops": ["row_number"], "as": ["colIndex"]},
        {"type": "formula", "as": "grandTotal", "expr": "3.5"}
      ]
    },
    {
      "name": "grand",
      "source": "raw",
      "transform": [
        {"type": "aggregate", "fields": ["value"], "ops": ["sum"], "as": ["gt"]}
      ]
    },
    {
      "name": "cells",
      "source": "raw",
      "transform": [
        {
          "type": "lookup", "from": "segTotals", "key": "segment",
          "fields": ["segment"], "values": ["segTotal", "colStart", "colEnd", "colIndex"]
        },
        {
          "type": "stack", "groupby": ["segment"], "field": "value",
          "as": ["rowStart", "rowEnd"],
          "sort": {"field": "source", "order": "descending"}
        },
        {"type": "formula", "as": "gtot", "expr": "data('grand')[0].gt"},
        {"type": "formula", "as": "colPad", "expr": "(datum.colIndex - 1) * gap"},
        {"type": "formula", "as": "px0", "expr": "scale('x', datum.colStart) + datum.colPad"},
        {"type": "formula", "as": "px1", "expr": "scale('x', datum.colEnd) + datum.colPad"},
        {"type": "formula", "as": "py0", "expr": "scale('y', datum.rowStart / datum.segTotal)"},
        {"type": "formula", "as": "py1", "expr": "scale('y', datum.rowEnd / datum.segTotal)"},
        {"type": "formula", "as": "cx", "expr": "0.5 * (datum.px0 + datum.px1)"},
        {"type": "formula", "as": "cy", "expr": "0.5 * (datum.py0 + datum.py1)"},
        {"type": "formula", "as": "cellW", "expr": "datum.px1 - datum.px0"},
        {"type": "formula", "as": "cellH", "expr": "datum.py1 - datum.py0"},
        {"type": "formula", "as": "pct", "expr": "round(100 * datum.value / datum.segTotal)"}
      ]
    },
    {
      "name": "colLabels",
      "source": "cells",
      "transform": [
        {"type": "aggregate", "groupby": ["segment", "colIndex"], "fields": ["px0", "px1", "segTotal"], "ops": ["min", "max", "max"], "as": ["lx0", "lx1", "segTotal"]},
        {"type": "formula", "as": "lcx", "expr": "0.5 * (datum.lx0 + datum.lx1)"},
        {"type": "formula", "as": "share", "expr": "round(100 * datum.segTotal / data('grand')[0].gt)"}
      ]
    }
  ],
  "scales": [
    {
      "name": "x", "type": "linear", "range": {"signal": "[0, width - 2*gap]"},
      "domain": {"data": "grand", "field": "gt"}, "domainMin": 0, "zero": true
    },
    {
      "name": "y", "type": "linear", "range": "height", "domain": [0, 1], "zero": true
    },
    {
      "name": "color", "type": "ordinal",
      "domain": ["Subscriptions", "Advertising", "Licensing"],
      "range": ["#007AFF", "#FF9500", "#AF52DE"]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "cells"},
      "encode": {
        "enter": {
          "fill": {"scale": "color", "field": "source"},
          "stroke": {"value": "#FFFFFF"},
          "strokeWidth": {"value": 1.5},
          "cornerRadius": {"value": 2}
        },
        "update": {
          "x": {"field": "px0"},
          "x2": {"field": "px1"},
          "y": {"field": "py0"},
          "y2": {"field": "py1"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "cells"},
      "encode": {
        "enter": {
          "font": {"value": "Roboto"},
          "fill": {"value": "#FFFFFF"},
          "fontSize": {"value": 10},
          "fontWeight": {"value": 600},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "text": {"signal": "datum.pct >= 12 ? datum.pct + '%' : ''"}
        },
        "update": {
          "x": {"field": "cx"},
          "y": {"field": "cy"},
          "opacity": {"signal": "datum.cellW > 26 && datum.cellH > 16 ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "colLabels"},
      "encode": {
        "enter": {
          "font": {"value": "Roboto"},
          "fill": {"value": "#1D1D1F"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": 600},
          "align": {"value": "center"},
          "baseline": {"value": "bottom"},
          "text": {"field": "segment"}
        },
        "update": {
          "x": {"field": "lcx"},
          "y": {"signal": "height + 15"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "colLabels"},
      "encode": {
        "enter": {
          "font": {"value": "Roboto Mono"},
          "fill": {"value": "#6E6E73"},
          "fontSize": {"value": 9.5},
          "align": {"value": "center"},
          "baseline": {"value": "bottom"},
          "text": {"signal": "datum.share + '% of revenue'"}
        },
        "update": {
          "x": {"field": "lcx"},
          "y": {"signal": "height + 28"}
        }
      }
    }
  ],
  "legends": [
    {
      "fill": "color",
      "orient": "top",
      "direction": "horizontal",
      "title": null,
      "labelFont": "Roboto",
      "labelColor": "#1D1D1F",
      "labelFontSize": 10.5,
      "symbolType": "square",
      "offset": 4
    }
  ]
}
